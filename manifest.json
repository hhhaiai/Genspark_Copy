{
  "manifest_version": 3,
  "name": "Genspark_Copy",
  "version": "2.0.0",
  "description": "Replace copy button in Genspark AI",
  "permissions": [
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.genspark.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.genspark.ai/*"
      ],
      "js": [
        "index.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.svg",
    "128": "icon128.svg"
  }
}